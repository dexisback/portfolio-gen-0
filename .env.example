# Site URL (for OG meta tags) — safe to expose, bundled into client code
VITE_SITE_URL=""

# Spotify Integration (SERVER-ONLY — do NOT prefix these with VITE_,
# Vite inlines VITE_* vars into the public client bundle!)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# To get your refresh token:
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Set redirect URI to http://localhost:3000/callback
# 3. Use the Authorization Code flow to get a refresh token
# 4. Required scopes: user-read-currently-playing, user-read-recently-played
